# Database (Replit provides these automatically)
DATABASE_URL=postgresql://user:password@host:5432/database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=ministrypath

# Session
SESSION_SECRET=your_session_secret_here

# Email (Mailgun)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.com

# OpenAI (for AI features)
AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Admin Account
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=ADMIN

# Object Storage (Replit provides these when configured)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your_bucket_id
PUBLIC_OBJECT_SEARCH_PATHS=public
PRIVATE_OBJECT_DIR=.private

# Public URL of this app, used for links in emails (invites, password resets)
# and Microsoft sign-in redirects. Falls back to the Replit domain if unset.
APP_BASE_URL=https://your-app.replit.app

# Microsoft Outlook Integration (optional)
# One multi-tenant Azure app owned by MinistryPath ("Accounts in any
# organizational directory"). Each ministry connects its own Microsoft 365
# tenant from Admin Panel > Integrations; tenants are never configured here.
# Register these redirect URIs on the app:
#   ${APP_BASE_URL}/api/org/outlook/callback
#   ${APP_BASE_URL}/api/org/outlook/consent-complete
# Application permissions (admin consent): Calendars.ReadWrite, Place.Read.All
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
