# MinistryPath Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE (Required)
# ===========================================
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ===========================================
# SESSION & SECURITY (Required)
# ===========================================
SESSION_SECRET=your-secure-random-session-secret-here
STATUS_KEY=your-secure-admin-bootstrap-key-here

# ===========================================
# OPENAI (Required for PDF Analysis)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# REPLIT AUTH (Auto-configured on Replit)
# ===========================================
# These are automatically set by Replit
# REPLIT_DEPLOYMENT_ID=
# REPLIT_DOMAINS=
# ISSUER_URL=

# ===========================================
# MAILGUN (Optional - for email features)
# ===========================================
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# OUTLOOK 365 (Optional - for calendar sync)
# ===========================================
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_TENANT_ID=your-azure-tenant-id

# ===========================================
# OBJECT STORAGE (Auto-configured on Replit)
# ===========================================
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PRIVATE_OBJECT_DIR=
# PUBLIC_OBJECT_SEARCH_PATHS=

# ===========================================
# SERVER CONFIG
# ===========================================
PORT=5000
NODE_ENV=development
